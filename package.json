{
  "name": "ai-ready-design-system-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Fixture repository for the AI-Ready Design System workshop",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "http-server . -o /examples/account-settings/index.html",
    "build": "node scripts/build-tokens.mjs",
