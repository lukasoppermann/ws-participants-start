    "reset": "bash scripts/reset-checkpoint.sh"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "stylelint": "17.14.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "design-tokens": "github:lukasoppermann/workshop-design-token-package"
  }
}
